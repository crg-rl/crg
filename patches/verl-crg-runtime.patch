+def should_offload_state_dict_to_cpu() -> bool:
+    """Return whether sharded FSDP checkpoint IO should offload tensors to CPU.
+
+    CUDA and Ascend NPU both benefit from CPU-offloaded state-dict IO here.
+    Using device-resident DTensor shards on NPU can trip the root-mesh assertion
+    during checkpoint load, so checkpoint paths should treat NPU the same way as
+    CUDA for this offload decision.
+    """
+
+    return is_cuda_available or is_npu_available
+
+
+def retarget_dtensor_tree_to_model_mesh(tree, target_mesh):
+    """Rebuild serialized DTensor shards onto the active model mesh.
+
+    Checkpoints saved on CUDA can contain CPU-offloaded DTensors whose
+    ``device_mesh`` still records a CUDA root mesh. Loading those shards on an
+    NPU-backed FSDP model trips PyTorch's root-mesh assertion before the
+    pre-load hook can move them. Rebuild the DTensors onto the current model
+    root mesh first so the subsequent SHARDED_STATE_DICT load sees matching
+    mesh metadata.
+    """
+
+    if target_mesh is None:
+        return tree
+    if isinstance(tree, DTensor):
+        local_tensor = tree.to_local()
+        if local_tensor.device.type != target_mesh.device_type:
+            local_tensor = local_tensor.to(target_mesh.device_type)
+        return DTensor.from_local(
+            local_tensor,
+            target_mesh,
+            tree.placements,
+            run_check=False,
+            shape=tree.size(),
+            stride=tree.stride(),
+        )
+    if isinstance(tree, dict):
+        return {key: retarget_dtensor_tree_to_model_mesh(value, target_mesh) for key, value in tree.items()}
+    if isinstance(tree, list):
+        return [retarget_dtensor_tree_to_model_mesh(value, target_mesh) for value in tree]
+    if isinstance(tree, tuple):
+        return tuple(retarget_dtensor_tree_to_model_mesh(value, target_mesh) for value in tree)
+    return tree
+
+
